# ── Required in production (the server refuses to start without these) ──────
# PostgreSQL for production. Run npm run db:migrate explicitly before release.
# Empty locally uses persistent .local-data/pglite; tests can use memory.
DATABASE_URL=
# Long random string. Also derives the key that encrypts scheduler credentials.
BETTER_AUTH_SECRET=
# Public origin of this deployment.
BETTER_AUTH_URL=http://localhost:8080
# Set the HTTPS production origin in the deployment environment.
# NODE_ENV is managed by the toolchain/deployment.
# PGLITE_DATA_DIR=.local-data/pglite
# PGLITE_IN_MEMORY=1  # disposable tests only

# ── Authentication ──────────────────────────────────────────────────────────
# Production must keep auth enabled. VITE_AUTH_ENABLED=false is accepted only
# by the local dev server and E2E tests (and never when DATABASE_URL is set).
VITE_AUTH_ENABLED=true
# Optional broker federation (Google / X through the Grok auth broker).
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=your-app-client-id
# GROK_AUTH_CLIENT_SECRET=your-app-client-secret

# ── CiteLock Visibility (answer-engine probes) ──────────────────────────────
# CiteLock probes and optional Social Desk drafting only; the assistant uses
# AI Gateway below. Provider acceptance must be checked for the target environment.
XAI_API_KEY=
# XAI_VISIBILITY_MODEL=grok-4.6
# XAI_EXTRACTION_MODEL=grok-4-1-fast-non-reasoning   # entity extraction; a non-reasoning model answers in ~1s (grok-4.6 takes ~30s and times out)
# XAI_DRAFT_MODEL=grok-4-1-fast-reasoning            # optional captions; page/FAQ packages assemble permitted passages
# OPENAI_API_KEY=
# OPENAI_VISIBILITY_MODEL=gpt-5.5
# GEMINI_API_KEY=
# GEMINI_VISIBILITY_MODEL=gemini-3.5-flash
# PERPLEXITY_API_KEY=
# Perplexity Agent API: explicit provider/model ID; legacy sonar IDs are unsupported.
# PERPLEXITY_VISIBILITY_MODEL=openai/gpt-5.6-luna
# Spend limits (defaults shown). Runs reserve up to two attempts each.
# Public-page inspection: 20 per workspace per day.
# CITELOCK_VISIBILITY_BATCHES_PER_DAY=3
# CITELOCK_VISIBILITY_RUNS_PER_DAY=300
# CITELOCK_VISIBILITY_RUNS_PER_CALL=2
# CITELOCK_VISIBILITY_BUDGET_MS=45000
# SOCIAL_DRAFTS_PER_DAY=40

# ── Access ──────────────────────────────────────────────────────────────────
# Comma-separated beta codes validated by the SERVER. When unset outside
# production, the five built-in pilot codes work; in production you must set it.
BETA_ACCESS_CODES=
# Stripe (one-time $9.99 / 30 days). Without a key, checkout is unavailable
# unless demo checkout is explicitly enabled in a non-production environment.
# STRIPE_SECRET_KEY=sk_test_...
# ALLOW_DEMO_CHECKOUT=1

# ── Market data (optional) ──────────────────────────────────────────────────
# Zillow-via-RapidAPI aggregator observations. Never MLS verification.
# RAPIDAPI_KEY=
# RAPIDAPI_DAILY_BUDGET=100

# ── Social publishing ───────────────────────────────────────────────────────
# Agents connect their own Postiz workspace in the app; nothing global is
# needed. Optional separate encryption secret for those stored API keys:
# SOCIAL_CONNECTION_SECRET=

# Vercel AI Gateway (server-only). On a configured Vercel project,
# Vercel Functions provide OIDC in the trusted request context; the official
# helper resolves it per call. Local development can use VERCEL_OIDC_TOKEN from
# vercel env pull. Use a static key only when OIDC is unavailable (for example,
# non-Vercel CI). Never prefix these with VITE_.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_ASSISTANT_MODEL=openai/gpt-5.6-luna
# Blocks providers that train on prompts on every Gateway plan. Zero data
# retention requires a supported Pro/Enterprise Gateway plan; enable only after
# the exact Vercel project entitlement is confirmed.
# AI_GATEWAY_ZERO_DATA_RETENTION=false
# ASSISTANT_INSTANCE_BURST_PER_MINUTE=20
# ASSISTANT_REQUESTS_PER_MINUTE=10
# ASSISTANT_REQUESTS_PER_DAY=100
# ASSISTANT_INPUT_CHARS_PER_DAY=250000
# Set both when overriding the default model so generation cost estimates stay
# accurate (USD per one million tokens).
# AI_GATEWAY_INPUT_USD_PER_MILLION=
# AI_GATEWAY_OUTPUT_USD_PER_MILLION=

# Deterministic social image rendering (server-only). Never prefix with VITE_.
# The app sends only server-resolved listing_media URLs and text substitutions;
# Orshot prompt/AI parameters are rejected. The template and host allowlists are required.
# ORSHOT_API_KEY=
# ORSHOT_TEMPLATE_MAPPINGS={"defaults":[{"key":"modern","label":"Modern","templateId":12345,"photoKeys":["photo"],"allImageLayersUseListingPhotos":true,"fields":{"address":"address","price":"price","bedrooms":"beds","bathrooms":"baths","sqft":"sqft"},"outputSize":"instagram-post"}],"workspaces":{}}
# SOCIAL_MEDIA_PHOTO_HOST_ALLOWLIST=your-public-listing-photo-bucket.example.com
# ORSHOT_OUTPUT_HOST_ALLOWLIST=your-confirmed-orshot-output-host.example.com
# SOCIAL_MEDIA_MAX_RENDERS_PER_PERIOD=50
# ORSHOT_TIMEOUT_MS=25000

# Social video is deliberately setup_required. Current CutCLI guidance says to
# use its cut_cli SDK/CLI rather than hand-build cloud endpoints. Do not add this
# key until the exact package/account flow passes a Vercel filesystem smoke test.
# CUTCLI_API_KEY=sk-...

# CiteLock controlled Recognition panel only (server-only).
# The assistant uses Vercel AI Gateway, not xAI directly.
# All three providers are required before the multi-model runner will execute.
XAI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Optional frozen-model overrides. Record any change as a new panel version.
# CITELOCK_OPENAI_MODEL=gpt-5-mini
# CITELOCK_XAI_MODEL=grok-4.6
# CITELOCK_PERPLEXITY_MODEL=sonar

# Managed actual-photo uploads are private in durable PostgreSQL by default.
# Optional public delivery to an approved paid renderer; never expose this token.
# BLOB_READ_WRITE_TOKEN=
# Paid social subscription (separate from one-time app access).
# Prefer a restricted key with customer, Checkout, subscription and portal permissions.
# STRIPE_SECRET_KEY=
# STRIPE_SOCIAL_PRICE_ID=
# STRIPE_SOCIAL_WEBHOOK_SECRET=
# SOCIAL_BILLING_RETURN_ORIGIN=https://your-app.example
# SOCIAL_MEDIA_INCLUDED_RENDERS=50
# Register subscription created/updated/deleted/paused/resumed events at:
# /api/webhooks/social-stripe
# Configure Stripe Tax and the customer portal before enabling paid checkout.
# ── Beta feedback delivery (server-only) ────────────────────────────────────
# GITHUB_TOKEN=github_pat_...
# RESEND_API_KEY=re_...
# BETA_FEEDBACK_EMAIL=you@example.com

# ── Capacitor live-reload only (never in production) ────────────────────────
# CAP_SERVER_URL=https://your-preview.vercel.app
