# Stripe (optional — without this, checkout runs in demo mode)
# Get your keys at https://dashboard.stripe.com/apikeys
# Use sk_test_... for development; sk_live_... for production.
# Never commit a live secret key to source control.
STRIPE_SECRET_KEY=sk_test_...

# Capacitor live server (optional)
# CAP_SERVER_URL=https://your-app.vercel.app

# Beta feedback email — FormSubmit delivers beta comments here
# Default: bpcca@icloud.com (override with your own address)
#
# FormSubmit one-time activation (required before emails are delivered):
#   1. Set BETA_FEEDBACK_EMAIL to the inbox you want to receive comments.
#   2. Deploy / run the app and submit any beta comment.
#   3. FormSubmit sends a confirmation to that address — click the link.
#   4. Subsequent comments are delivered automatically.
#   Until activated, FormSubmit returns a token/activation error;
#   the client falls back to opening a mailto: draft automatically.
# BETA_FEEDBACK_EMAIL=you@example.com
