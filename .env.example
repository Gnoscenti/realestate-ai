# Stripe (optional — without this, checkout runs in demo mode)
STRIPE_SECRET_KEY=sk_test_...

# Beta feedback delivery (server-only; never prefix these with VITE_)
# Required for Suggest -> GitHub Issue. Fine-grained token: Issues read/write.
# Add Contents read/write only if you also want markdown mirrored into Beta comments/.
GITHUB_TOKEN=github_pat_...
# Optional server-only email copy through Resend.
RESEND_API_KEY=re_...
BETA_FEEDBACK_EMAIL=you@example.com
# ALERT_EMAIL, when set, overrides BETA_FEEDBACK_EMAIL.
# ALERT_EMAIL=alerts@example.com

# Capacitor live-reload only. Capacitor explicitly does not recommend server.url
# for production; release builds should use bundled web assets.
# CAP_SERVER_URL=https://your-preview.vercel.app
