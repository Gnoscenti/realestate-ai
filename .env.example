# Authentication (required for deployed beta)
# Production must keep auth enabled. VITE_AUTH_ENABLED=false is accepted only
# by the local dev server and E2E tests.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://cloud-realtor.grok.me
BETTER_AUTH_SECRET=replace-with-a-long-random-server-secret
DATABASE_URL=postgresql://user:password@host/database
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=your-app-client-id
GROK_AUTH_CLIENT_SECRET=your-app-client-secret

# Sandbox preview only. Keep the shared preview credential in the platform's
# server-side environment; never commit it.
# GROK_PREVIEW_CLIENT_ID=grok_preview
# GROK_PREVIEW_CLIENT_SECRET=replace-with-preview-secret

# Stripe (optional). Without a key, checkout is unavailable unless demo checkout
# is explicitly enabled in a non-production/test environment.
# STRIPE_SECRET_KEY=sk_test_...
# ALLOW_DEMO_CHECKOUT=1

# Beta feedback delivery (server-only; never prefix these with VITE_)
# Required for Suggest -> GitHub Issue. Fine-grained token: Issues read/write.
# Add Contents read/write only if you also want markdown mirrored into Beta comments/.
GITHUB_TOKEN=github_pat_...
# Optional server-only email copy through Resend.
RESEND_API_KEY=re_...
BETA_FEEDBACK_EMAIL=you@example.com
# ALERT_EMAIL, when set, overrides BETA_FEEDBACK_EMAIL.
# ALERT_EMAIL=alerts@example.com

# Capacitor live-reload only. Capacitor explicitly does not recommend server.url
# for production; release builds should use bundled web assets.
# CAP_SERVER_URL=https://your-preview.vercel.app

# Vercel AI Gateway (server-only). On a configured Vercel project,
# VERCEL_OIDC_TOKEN is injected automatically; use a static key only when OIDC
# is unavailable (for example, non-Vercel CI). Never prefix these with VITE_.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_ASSISTANT_MODEL=openai/gpt-5.6-luna
# Blocks providers that train on prompts on every Gateway plan. Zero data
# retention requires a supported Pro/Enterprise Gateway plan; enable only after
# the exact Vercel project entitlement is confirmed.
# AI_GATEWAY_ZERO_DATA_RETENTION=false
# ASSISTANT_INSTANCE_BURST_PER_MINUTE=20
# ASSISTANT_REQUESTS_PER_MINUTE=10
# ASSISTANT_REQUESTS_PER_DAY=100
# ASSISTANT_INPUT_CHARS_PER_DAY=250000
# Set both when overriding the default model so generation cost estimates stay
# accurate (USD per one million tokens).
# AI_GATEWAY_INPUT_USD_PER_MILLION=
# AI_GATEWAY_OUTPUT_USD_PER_MILLION=

# Deterministic social renderers (server-only). These remain disabled until the
# media-job ownership, idempotency, and quota layer is wired. Never prefix with
# VITE_. Templates must overlay actual listing photos; no generative imagery.
# ORSHOT_API_KEY=
# ORSHOT_TEMPLATE_ID=
# CUTCLI_API_KEY=
