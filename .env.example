# Authentication (required for deployed beta)
# Production must keep auth enabled. VITE_AUTH_ENABLED=false is accepted only
# by the local dev server and E2E tests.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://cloud-realtor.grok.me
BETTER_AUTH_SECRET=replace-with-a-long-random-server-secret
DATABASE_URL=postgresql://user:password@host/database
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=your-app-client-id
GROK_AUTH_CLIENT_SECRET=your-app-client-secret

# Sandbox preview only. Keep the shared preview credential in the platform's
# server-side environment; never commit it.
# GROK_PREVIEW_CLIENT_ID=grok_preview
# GROK_PREVIEW_CLIENT_SECRET=replace-with-preview-secret

# Stripe (optional). Without a key, checkout is unavailable unless demo checkout
# is explicitly enabled in a non-production/test environment.
# STRIPE_SECRET_KEY=sk_test_...
# Signed webhook secret for POST /api/webhooks/stripe. Required before Voice
# checkout is shown; without it the app refuses to charge for the add-on.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Active recurring Stripe Price: exactly $79.00 USD every month. The server
# retrieves and validates this Price before creating a subscription checkout.
# STRIPE_VOICE_PRICE_ID=price_...
# ALLOW_DEMO_CHECKOUT=1

# Beta feedback delivery (server-only; never prefix these with VITE_)
# Required for Suggest -> GitHub Issue. Fine-grained token: Issues read/write.
# Add Contents read/write only if you also want markdown mirrored into Beta comments/.
GITHUB_TOKEN=github_pat_...
# Optional server-only email copy through Resend.
RESEND_API_KEY=re_...
BETA_FEEDBACK_EMAIL=you@example.com
# ALERT_EMAIL, when set, overrides BETA_FEEDBACK_EMAIL.
# ALERT_EMAIL=alerts@example.com

# Capacitor live-reload only. Capacitor explicitly does not recommend server.url
# for production; release builds should use bundled web assets.
# CAP_SERVER_URL=https://your-preview.vercel.app

# Vercel AI Gateway (server-only). On a configured Vercel project,
# VERCEL_OIDC_TOKEN is injected automatically; use a static key only when OIDC
# is unavailable (for example, non-Vercel CI). Never prefix these with VITE_.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_ASSISTANT_MODEL=openai/gpt-5.6-luna
# Blocks providers that train on prompts on every Gateway plan. Zero data
# retention requires a supported Pro/Enterprise Gateway plan; enable only after
# the exact Vercel project entitlement is confirmed.
# AI_GATEWAY_ZERO_DATA_RETENTION=false
# ASSISTANT_INSTANCE_BURST_PER_MINUTE=20
# ASSISTANT_REQUESTS_PER_MINUTE=10
# ASSISTANT_REQUESTS_PER_DAY=100
# ASSISTANT_INPUT_CHARS_PER_DAY=250000
# Set both when overriding the default model so generation cost estimates stay
# accurate (USD per one million tokens).
# AI_GATEWAY_INPUT_USD_PER_MILLION=
# AI_GATEWAY_OUTPUT_USD_PER_MILLION=

# Deterministic social image rendering (server-only). Never prefix with VITE_.
# The app sends only server-resolved listing_media URLs and text substitutions;
# Orshot prompt/AI parameters are rejected. The template and host allowlists are required.
# ORSHOT_API_KEY=
# ORSHOT_TEMPLATE_MAPPINGS={"defaults":[{"key":"modern","label":"Modern","templateId":12345,"photoKeys":["photo"],"allImageLayersUseListingPhotos":true,"fields":{"address":"address","price":"price","bedrooms":"beds","bathrooms":"baths","sqft":"sqft"},"outputSize":"instagram-post"}],"workspaces":{}}
# SOCIAL_MEDIA_PHOTO_HOST_ALLOWLIST=your-public-listing-photo-bucket.example.com
# ORSHOT_OUTPUT_HOST_ALLOWLIST=your-confirmed-orshot-output-host.example.com
# SOCIAL_MEDIA_MAX_RENDERS_PER_PERIOD=50
# ORSHOT_TIMEOUT_MS=25000

# Social video is deliberately setup_required. Current CutCLI guidance says to
# use its cut_cli SDK/CLI rather than hand-build cloud endpoints. Do not add this
# key until the exact package/account flow passes a Vercel filesystem smoke test.
# CUTCLI_API_KEY=sk-...

# CiteLock controlled Recognition panel only (server-only).
# The assistant uses Vercel AI Gateway, not xAI directly.
# All three providers are required before the multi-model runner will execute.
XAI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Optional frozen-model overrides. Record any change as a new panel version.
# CITELOCK_OPENAI_MODEL=gpt-5-mini
# CITELOCK_XAI_MODEL=grok-4.6
# CITELOCK_PERPLEXITY_MODEL=sonar

# Managed actual-photo uploads are private in durable PostgreSQL by default.
# Optional public delivery to an approved paid renderer; never expose this token.
# BLOB_READ_WRITE_TOKEN=
# Paid social subscription (separate from one-time app access).
# Prefer a restricted key with customer, Checkout, subscription and portal permissions.
# STRIPE_SECRET_KEY=
# STRIPE_SOCIAL_PRICE_ID=
# STRIPE_SOCIAL_WEBHOOK_SECRET=
# SOCIAL_BILLING_RETURN_ORIGIN=https://your-app.example
# SOCIAL_MEDIA_INCLUDED_RENDERS=50
# Register subscription created/updated/deleted/paused/resumed events at:
# /api/webhooks/social-stripe
# Configure Stripe Tax and the customer portal before enabling paid checkout.

# Premium inbound Voice Assistant (all server-only; never prefix with VITE_)
# Retell runtime + signed post-call webhooks.
RETELL_API_KEY=
# The Retell key carrying the webhook badge; it may be the same key value.
RETELL_WEBHOOK_API_KEY=
RETELL_VOICE_ID=
# Optional; defaults to gpt-4.1-mini.
RETELL_MODEL=gpt-4.1-mini
VOICE_WEBHOOK_BASE_URL=https://cloud-realtor.grok.me

# Customer-controlled Twilio number + Elastic SIP trunk. Production requires
# an API Key SID/secret; account auth tokens are accepted only outside prod.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=local-development-only
# Supply an existing shared trunk SID, or a unique domain to create one.
TWILIO_SIP_TRUNK_SID=
TWILIO_SIP_TRUNK_DOMAIN=cloud-realtor.pstn.twilio.com
VOICE_DEFAULT_AREA_CODE=503

# Vercel Cron authenticates the daily recovery, billing-policy, privacy, and
# retention sweep. Signed webhooks are processed inline after the durable write.
CRON_SECRET=replace-with-a-long-random-server-secret
